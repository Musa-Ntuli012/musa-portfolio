rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Projects are public read (the portfolio is a public site) and
    // writable only by an authenticated admin. This is a single admin
    // site, so any signed in user is treated as the admin — do not
    // enable public sign up in the Firebase console, only create your
    // one admin user by hand in Authentication.
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
